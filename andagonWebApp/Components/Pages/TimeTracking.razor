@page "/time-tracking"
@rendermode InteractiveServer

<PageTitle>Zeiterfassung</PageTitle>

<h2 class="text-xl font-semibold mb-4">Arbeitszeit erfassen</h2>
<form id="time-tracking-form" class="mb-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div>
            <label for="work-date" class="block text-sm font-medium text-gray-700 mb-1">Datum</label>
            <input type="date" id="work-date" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" required>
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label for="start-time" class="block text-sm font-medium text-gray-700 mb-1">Startzeit</label>
                <input type="time" id="start-time" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" required>
            </div>
            <div>
                <label for="end-time" class="block text-sm font-medium text-gray-700 mb-1">Endzeit</label>
                <input type="time" id="end-time" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" required>
            </div>
        </div>
    </div>
    <div class="mb-4">
        <label for="work-description" class="block text-sm font-medium text-gray-700 mb-1">Beschreibung</label>
        <textarea id="work-description" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" placeholder="Tätigkeiten beschreiben" required></textarea>
    </div>
    <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-md font-medium">
        <i class="fas fa-save mr-2"></i>Speichern
    </button>
</form>

<h2 class="text-xl font-semibold mb-4">Arbeitszeitübersicht</h2>
<div class="mb-4 flex justify-between items-center">
    <div>
        <label for="time-filter-month" class="block text-sm font-medium text-gray-700 mb-1">Monat auswählen</label>
        <input type="month" id="time-filter-month" class="px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
    </div>
    <div class="text-lg font-semibold">
        Gesamtstunden: <span id="total-hours">0:00</span>
    </div>
</div>
<div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Datum</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Start</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ende</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dauer</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Beschreibung</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"></th>
            </tr>
        </thead>
        <tbody id="time-entries-list" class="bg-white divide-y divide-gray-200">
            <tr class="time-entry working-time">
                <td class="px-6 py-4 whitespace-nowrap">15.05.2023</td>
                <td class="px-6 py-4 whitespace-nowrap">08:30</td>
                <td class="px-6 py-4 whitespace-nowrap">17:15</td>
                <td class="px-6 py-4 whitespace-nowrap">8:45</td>
                <td class="px-6 py-4">Projektarbeit für Kunde XYZ</td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <button class="delete-entry text-red-500 hover:text-red-700 hidden">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
            <tr class="time-entry working-time">
                <td class="px-6 py-4 whitespace-nowrap">14.05.2023</td>
                <td class="px-6 py-4 whitespace-nowrap">09:00</td>
                <td class="px-6 py-4 whitespace-nowrap">18:30</td>
                <td class="px-6 py-4 whitespace-nowrap">9:30</td>
                <td class="px-6 py-4">Teammeeting und Code-Review</td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <button class="delete-entry text-red-500 hover:text-red-700 hidden">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<div class="mt-8">
    <h2 class="text-xl font-semibold mb-4">Arbeitszeitstatistik</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white p-4 rounded-lg shadow">
            <h3 class="text-lg font-medium text-gray-700">Durchschnitt pro Tag</h3>
            <p class="text-3xl font-bold text-blue-500" id="avg-hours-day">8:45</p>
        </div>
        <div class="bg-white p-4 rounded-lg shadow">
            <h3 class="text-lg font-medium text-gray-700">Arbeitstage</h3>
            <p class="text-3xl font-bold text-green-500" id="work-days">2</p>
        </div>
        <div class="bg-white p-4 rounded-lg shadow">
            <h3 class="text-lg font-medium text-gray-700">Überstunden</h3>
            <p class="text-3xl font-bold text-orange-500" id="overtime">1:15</p>
        </div>
    </div>
</div>

