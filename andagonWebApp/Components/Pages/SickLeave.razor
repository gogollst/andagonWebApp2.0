@page "/sick-leave"
@rendermode InteractiveServer

@using System.IO
@using System.ComponentModel.DataAnnotations

<h2 class="text-xl font-semibold mb-4">Krankmeldung erfassen</h2>
<EditForm Model="sickLeaveModel" OnValidSubmit="HandleSubmit" class="mb-8">
    <DataAnnotationsValidator />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div>
            <label for="sick-from" class="block text-sm font-medium text-gray-700 mb-1">Von</label>
            <InputDate id="sick-from" @bind-Value="sickLeaveModel.SickFrom" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" required />
            <ValidationMessage For="() => sickLeaveModel.SickFrom" />
        </div>
        <div>
            <label for="sick-to" class="block text-sm font-medium text-gray-700 mb-1">Bis</label>
            <InputDate id="sick-to" @bind-Value="sickLeaveModel.SickTo" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" required />
            <ValidationMessage For="() => sickLeaveModel.SickTo" />
        </div>
    </div>
    <div class="mb-4">
        <label for="sick-reason" class="block text-sm font-medium text-gray-700 mb-1">Begründung</label>
        <InputTextArea id="sick-reason" @bind-Value="sickLeaveModel.Reason" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" placeholder="Krankheitsgrund beschreiben" required />
        <ValidationMessage For="() => sickLeaveModel.Reason" />
    </div>
    <div class="mb-4">
        <label for="sick-file" class="block text-sm font-medium text-gray-700 mb-1">Krankschreibung</label>
        <div class="file-upload">
            <button type="button" class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-4 py-2 rounded-md font-medium" @onclick="TriggerFileInput">
                <i class="fas fa-file-upload mr-2"></i>Dokument hochladen
            </button>
            <InputFile id="sick-file" class="hidden" OnChange="HandleFileUpload" accept=".pdf" />
            <span class="ml-2 text-sm text-gray-600">@FileName</span>
        </div>
    </div>
    <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-md font-medium">
        <i class="fas fa-paper-plane mr-2"></i>Absenden
    </button>
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <p class="text-red-500 mt-2">@ErrorMessage</p>
    }
</EditForm>

<h2 class="text-xl font-semibold mb-4">Meine Krankmeldungen</h2>
<div class="mb-4">
    <label for="sick-filter-month" class="block text-sm font-medium text-gray-700 mb-1">Monat auswählen</label>
    <input type="month" id="sick-filter-month" class="px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" 
           @onchange="FilterByMonth" />
</div>
<div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Zeitraum</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tage</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dokument</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            @foreach (var sickLeave in FilteredSickLeaves)
            {
                <tr class="sick-leave">
                    <td class="px-6 py-4 whitespace-nowrap">@sickLeave.SickFrom.ToString("dd.MM.yyyy") - @sickLeave.SickTo.ToString("dd.MM.yyyy")</td>
                    <td class="px-6 py-4 whitespace-nowrap">@((sickLeave.SickTo - sickLeave.SickFrom).Days + 1)</td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2 py-1 text-xs font-medium rounded-full @(sickLeave.Status == "Eingereicht" ? "bg-blue-100 text-blue-800" : "bg-green-100 text-green-800")">
                            @sickLeave.Status
                        </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        @if (!string.IsNullOrEmpty(sickLeave.DocumentPath))
                        {
                            <a href="@sickLeave.DocumentPath" class="text-blue-500 hover:text-blue-700" target="_blank">
                                <i class="fas fa-file-pdf mr-1"></i>Ansehen
                            </a>
                        }
                        else
                        {
                            <span class="text-gray-500">Kein Dokument</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private SickLeaveModel sickLeaveModel { get; set; } = new();
    private List<SickLeaveModel> SickLeaves { get; set; } = new();
    private List<SickLeaveModel> FilteredSickLeaves { get; set; } = new();
    private DateTime? SelectedMonth { get; set; }
    private string FileName { get; set; } = "Keine Datei ausgewählt";
    private byte[]? UploadedFile { get; set; }
    private string ErrorMessage { get; set; }
    private EditForm editForm;
    private OdooManager odooManager;
    private long EmployeeId = 0;
    protected override async Task OnInitializedAsync()
    {
        if (odooManager != null) return; // Verhindert mehrfaches Initialisieren
        odooManager = new();
        await odooManager.Authenticate();
        EmployeeId = await odooManager.GetEmployeeIdByEmail("s.gogoll@andagon.com");
    }

    private async Task HandleSubmit()
    {
        try
        {
            // Validierung
            if (sickLeaveModel.SickTo < sickLeaveModel.SickFrom)
            {
                ErrorMessage = "Das Enddatum darf nicht vor dem Startdatum liegen.";
                return;
            }

            // eAU-Abruf über DATEV (Platzhalter)
            // var eau = await DatevService.RequestEAUAsync(
            //     mitarbeiterId: "MITARBEITER_ID", // Ersetze durch echte ID
            //     krankVon: sickLeaveModel.SickFrom,
            //     art: sickLeaveModel.Reason
            // );

            // Dokument speichern (Platzhalter)
            string documentPath = null;
            if (UploadedFile != null)
            {
                // In Produktion: Datei auf Server oder Cloud-Speicher speichern
                documentPath = $"/files/sickleave_{Guid.NewGuid()}.pdf";
            }

            // Krankmeldung speichern
            var newSickLeave = new SickLeaveModel
            {
                SickFrom = sickLeaveModel.SickFrom,
                SickTo = sickLeaveModel.SickTo,
                Reason = sickLeaveModel.Reason,
                Status = "Eingereicht",
                DocumentPath = documentPath
            };
            SickLeaves.Add(newSickLeave);
            FilteredSickLeaves = SickLeaves;

            // Formular zurücksetzen
            sickLeaveModel = new();
            FileName = "Keine Datei ausgewählt";
            UploadedFile = null;
            ErrorMessage = null;

            // eAU-Status in Status integrieren (Beispiel)
            // if (eau?.Status == "Genehmigt") // Annahme: DATEV gibt Status zurück
            // {
            //     newSickLeave.Status = "Genehmigt";
            // }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Fehler beim Speichern der Krankmeldung: {ex.Message}";
        }
    }

    private void TriggerFileInput()
    {
        // Workaround, um den versteckten InputFile-Button zu triggern
        // Blazor erlaubt kein direktes @onclick auf InputFile
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            if (file.ContentType != "application/pdf")
            {
                ErrorMessage = "Bitte laden Sie nur PDF-Dateien hoch.";
                return;
            }

            // Datei in Speicher lesen (max. 5 MB als Beispiel)
            const int maxFileSize = 5 * 1024 * 1024;
            if (file.Size > maxFileSize)
            {
                ErrorMessage = "Die Datei ist zu groß (max. 5 MB).";
                return;
            }

            using var stream = file.OpenReadStream(maxFileSize);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            UploadedFile = memoryStream.ToArray();
            FileName = file.Name;
            ErrorMessage = null;
        }
    }

    private void FilterByMonth(ChangeEventArgs e)
    {
        if (e.Value != null && DateTime.TryParse(e.Value.ToString() + "-01", out var parsedDate))
        {
            SelectedMonth = parsedDate;
            FilteredSickLeaves = SickLeaves
                .Where(sl => sl.SickFrom.Year == parsedDate.Year && sl.SickFrom.Month == parsedDate.Month)
                .ToList();
        }
        else
        {
            SelectedMonth = null;
            FilteredSickLeaves = SickLeaves;
        }
        StateHasChanged();
    }

    public class SickLeaveModel
    {
        [Required(ErrorMessage = "Das Startdatum ist erforderlich.")]
        public DateTime SickFrom { get; set; }
        public bool HalfDay { get; set; } = false;

        [Required(ErrorMessage = "Das Enddatum ist erforderlich.")]
        public DateTime SickTo { get; set; }

        [Required(ErrorMessage = "Eine Begründung ist erforderlich.")]
        public string Reason { get; set; }

        public string Status { get; set; } = "Eingereicht";
        public string DocumentPath { get; set; }
    }
}
